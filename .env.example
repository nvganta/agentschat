# Optional. SQLite file location; defaults to ./data/agentschat.db
DATABASE_PATH=
# Optional. Default Anthropic key; each agent can also have its own in settings
ANTHROPIC_API_KEY=
# Optional. Only used by Notion context import
NOTION_API_KEY=
# Set to 1 to use the labelled test adapter instead of Claude (no provider calls)
AGENTSCHAT_FAKE_AGENT=
